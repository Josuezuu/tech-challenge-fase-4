# Copie para .env. Sem chave, tudo roda em modo simulado (respostas gravadas ou heurísticas).

# auto: usa o serviço real quando a chave existe; real: falha sem chave; simulado: nunca chama a rede
MONITOR_MODO_NUVEM=auto

# Azure AI Speech (recurso "Speech")
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure AI Language (recurso "Language"): sentimento, frases-chave, Text Analytics for health
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=

# OpenAI: texto do alerta, relatório da sessão e Whisper como linha de base
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
